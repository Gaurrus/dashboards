{
  "version": 1,
  "author": "T3 Dash",
  "editor": "manual",
  "description": "Подключение датчиков VW T3 к Waveshare ESP32-S3-Touch-LCD-7 через I2C, GPIO6, UART2 и оптопары. Это документация, а не Wokwi-симуляция.",
  "board": {
    "name": "Waveshare ESP32-S3-Touch-LCD-7",
    "mcu": "ESP32-S3",
    "note": "Экран, тач GT911 и CH422G уже занимают большинство GPIO. Свободных выведенных GPIO почти нет."
  },
  "parts": [
    {
      "id": "board",
      "type": "waveshare-esp32-s3-touch-lcd-7",
      "attrs": {
        "I2C": "3V3, GND, SDA=GPIO8, SCL=GPIO9 (общая с GT911 и CH422G)",
        "SENSOR": "3V3, GND, ADC=GPIO6 (0..3.1V)",
        "UART2": "3V3, GND, TX=GPIO43, RX=GPIO44 (переключатель с USB-UART)"
      }
    },
    {
      "id": "ads",
      "type": "ads1115",
      "attrs": {
        "address": "0x48",
        "gain": "GAIN_ONE (+/-4.096V)",
        "note": "ADDR -> GND"
      }
    },
    {
      "id": "mcp",
      "type": "mcp23017",
      "attrs": {
        "address": "0x21",
        "note": "A0=1, A1=0, A2=0; 0x20 занят CH422G"
      }
    },
    {
      "id": "opto",
      "type": "optocoupler-16ch",
      "attrs": {
        "input": "12V active-high (1k/2W + reverse diode)",
        "output": "open collector, active-low",
        "note": "1 канал на каждый 12V-вход; выходы на MCP23017"
      }
    },
    {
      "id": "gps",
      "type": "neo-6m",
      "attrs": {
        "baud": "9600",
        "power": "3.3V"
      }
    },
    {
      "id": "batDiv",
      "type": "resistor-divider",
      "attrs": {
        "top": "100k",
        "bottom": "22k",
        "input": "12..15V",
        "output": "2.16..2.70V",
        "note": "плюс 3.3V zener + 100nF"
      }
    },
    {
      "id": "coolant",
      "type": "resistive-sender",
      "attrs": {
        "pullup": "2.2k to 3.3V",
        "note": "датчик температуры/CHT"
      }
    },
    {
      "id": "fuel",
      "type": "resistive-sender",
      "attrs": {
        "pullup": "150R to 3.3V",
        "note": "датчик уровня топлива"
      }
    },
    {
      "id": "rpmOpto",
      "type": "optocoupler",
      "attrs": {
        "input": "импульсы катушки зажигания, 12V через 10k/2W + 1N4007 + 15V zener",
        "output": "open collector -> GPIO6",
        "note": "10k pull-up GPIO6 -> 3.3V"
      }
    },
    {
      "id": "bz",
      "type": "npn-buzzer-driver",
      "attrs": {
        "input": "MCP23017 GPB7 через 1k",
        "note": "опционально"
      }
    }
  ],
  "connections": [
    ["board:I2C_3V3", "ads:VDD", "red", ["3.3V only"]],
    ["board:I2C_GND", "ads:GND", "black", []],
    ["board:I2C_3V3", "mcp:VDD", "red", ["3.3V only"]],
    ["board:I2C_GND", "mcp:GND", "black", []],

    ["board:I2C_SDA", "ads:SDA", "blue", ["GPIO8"]],
    ["board:I2C_SCL", "ads:SCL", "yellow", ["GPIO9"]],
    ["board:I2C_SDA", "mcp:SDA", "blue", ["GPIO8"]],
    ["board:I2C_SCL", "mcp:SCL", "yellow", ["GPIO9"]],

    ["ads:ADDR", "ads:GND", "black", ["address 0x48"]],
    ["mcp:A0", "mcp:VDD", "red", ["address 0x21, A0=1"]],
    ["mcp:A1", "mcp:GND", "black", ["A1=0"]],
    ["mcp:A2", "mcp:GND", "black", ["A2=0"]],
    ["mcp:RESET", "mcp:VDD", "red", ["or 10k pull-up"]],

    ["ads:A0", "batDiv:OUT", "green", ["battery voltage"]],
    ["ads:A1", "coolant:SIG", "green", ["coolant/CHT"]],
    ["ads:A2", "fuel:SIG", "green", ["fuel level"]],
    ["ads:A3", "board:I2C_3V3", "green", ["excitation reference"]],

    ["opto:OUT1", "mcp:GPA0", "green", ["oil pressure warning"]],
    ["opto:OUT2", "mcp:GPA1", "green", ["charge warning"]],
    ["opto:OUT3", "mcp:GPA2", "green", ["high beam"]],
    ["opto:OUT4", "mcp:GPA3", "green", ["low beam"]],
    ["opto:OUT5", "mcp:GPA4", "green", ["turn left"]],
    ["opto:OUT6", "mcp:GPA5", "green", ["turn right"]],
    ["opto:OUT7", "mcp:GPA6", "green", ["glow plug"]],
    ["opto:OUT8", "mcp:GPA7", "green", ["ignition on"]],
    ["opto:OUT9", "mcp:GPB0", "green", ["parking brake (optional)"]],

    ["opto:BOARD_GND", "board:I2C_GND", "black", ["output side"]],
    ["opto:CAR_GND", "car:GND", "black", ["input side; isolated from board GND"]],
    ["opto:IN1", "signal:oil", "orange", ["12V active-high"]],
    ["opto:IN2", "signal:charge", "orange", ["12V active-high"]],
    ["opto:IN3", "signal:highBeam", "orange", ["12V active-high"]],
    ["opto:IN4", "signal:lowBeam", "orange", ["12V active-high"]],
    ["opto:IN5", "signal:turnLeft", "orange", ["12V active-high"]],
    ["opto:IN6", "signal:turnRight", "orange", ["12V active-high"]],
    ["opto:IN7", "signal:glowPlug", "orange", ["12V active-high"]],
    ["opto:IN8", "signal:ignition", "orange", ["12V active-high"]],
    ["opto:IN9", "signal:parkingBrake", "orange", ["12V active-high, optional"]],

    ["board:SENSOR_3V3", "rpmOpto:PULLUP", "red", ["10k to GPIO6"]],
    ["rpmOpto:OUT", "board:SENSOR_ADC", "green", ["GPIO6, digital input"]],
    ["rpmOpto:GND", "board:SENSOR_GND", "black", ["output side"]],
    ["rpmOpto:IN", "signal:coilNegative", "orange", ["12V pulses"]],
    ["rpmOpto:CAR_GND", "car:GND", "black", ["input side"]],

    ["board:UART2_3V3", "gps:VCC", "red", ["3.3V module only"]],
    ["board:UART2_GND", "gps:GND", "black", []],
    ["board:UART2_TX", "gps:RX", "green", ["GPIO43"]],
    ["board:UART2_RX", "gps:TX", "green", ["GPIO44"]],

    ["mcp:GPB7", "bz:IN", "green", ["optional buzzer"]],
    ["bz:GND", "board:I2C_GND", "black", []]
  ],
  "signals": [
    { "name": "batteryV", "source": "АКБ 12..15V", "input": "ADS1115 A0", "note": "делитель 100k/22k" },
    { "name": "coolantC", "source": "датчик температуры/CHT", "input": "ADS1115 A1", "note": "2.2k pull-up" },
    { "name": "fuelPct", "source": "датчик уровня топлива", "input": "ADS1115 A2", "note": "150R pull-up" },
    { "name": "excitation", "source": "3.3V rail", "input": "ADS1115 A3", "note": "ratiometric reference" },
    { "name": "rpm", "source": "катушка зажигания", "input": "GPIO6", "note": "оптопара + 10k pull-up" },
    { "name": "gps", "source": "NEO-6M", "input": "UART2 GPIO43/44", "note": "9600 baud" },
    { "name": "oilWarning", "source": "12V лампа масла", "input": "MCP23017 GPA0", "note": "active-low после оптопары" },
    { "name": "chargeWarning", "source": "12V лампа заряда", "input": "MCP23017 GPA1", "note": "active-low" },
    { "name": "highBeam", "source": "12V дальний свет", "input": "MCP23017 GPA2", "note": "active-low" },
    { "name": "lowBeam", "source": "12V ближний свет", "input": "MCP23017 GPA3", "note": "active-low" },
    { "name": "turnLeft", "source": "12V поворотник L", "input": "MCP23017 GPA4", "note": "active-low" },
    { "name": "turnRight", "source": "12V поворотник R", "input": "MCP23017 GPA5", "note": "active-low" },
    { "name": "glowPlug", "source": "12V свечи накала", "input": "MCP23017 GPA6", "note": "active-low" },
    { "name": "ignition", "source": "12V зажигание", "input": "MCP23017 GPA7", "note": "active-low" },
    { "name": "parkingBrake", "source": "12V ручник", "input": "MCP23017 GPB0", "note": "опционально" }
  ],
  "notes": [
    "I2C на GPIO8/9 общая с GT911 и CH422G: используйте только свободные адреса.",
    "GT911: 0x5D/0x14, CH422G: 0x20 (по конфигу платы). ADS1115: 0x48, MCP23017: 0x21.",
    "Все I2C-модули питать только от 3.3V. На плате уже есть pull-up 4.7k; лишние pull-up на модулях лучше снять.",
    "12V-входы заводить только через оптопары/делители. Общий провод платы и автомобиля — по схеме питания.",
    "GPIO6: 0..3.1V ADC. Для RPM использовать как цифровой вход с внешним 10k pull-up к 3.3V.",
    "UART2 (GPIO43/44) делит порт с USB-UART через переключатель: GPS и отладочный Serial одновременно не использовать.",
    "GPIO15/16 заняты RS485-трансивером, GPIO19/20 — CAN/USB, GPIO11/12/13 — TF-слотом.",
    "GPIO35 в прототипном hal_real.cpp — это ESP32 DevKit; на Waveshare GPIO33..37 заняты OPI PSRAM.",
    "ADS1115 gain: GAIN_ONE (±4.096V) для делителя АКБ; входы не должны превышать VDD+0.3V.",
    "Записи signal:* и car:GND — именованные внешние цепи автомобиля, а не детали на плате.",
    "Диаграмма: wiring.svg / wiring.png; подробный netlist: wiring.json."
  ]
}
